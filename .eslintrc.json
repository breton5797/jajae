{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "import"],
  "extends": ["next/core-web-vitals"],
  "rules": {
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": "./lib/catalog",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote"],
            "message": "lib/catalog must not depend on other domain modules."
          },
          {
            "target": "./lib/orders",
            "from": ["./lib/settlement", "./lib/ai-quote", "./lib/catalog/server.ts"],
            "message": "lib/orders may use shared types only, not other domain modules."
          },
          {
            "target": "./lib/settlement",
            "from": ["./lib/orders", "./lib/ai-quote", "./lib/catalog"],
            "message": "lib/settlement must not depend on other domain modules."
          },
          {
            "target": "./lib/ai-quote",
            "from": ["./lib/orders", "./lib/settlement", "./lib/pricing", "./lib/projects"],
            "message": "lib/ai-quote must not depend on orders/settlement/pricing/projects."
          },
          {
            "target": "./lib/pricing",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/projects"],
            "message": "lib/pricing must not depend on other domain modules."
          },
          {
            "target": "./lib/projects",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing"],
            "message": "lib/projects must not depend on other domain modules."
          },
          {
            "target": "./lib/pb",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/groupbuy", "./lib/finance"],
            "message": "lib/pb must not depend on other domain modules."
          },
          {
            "target": "./lib/groupbuy",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/finance"],
            "message": "lib/groupbuy must not depend on other domain modules."
          },
          {
            "target": "./lib/finance",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy"],
            "message": "lib/finance must not depend on other domain modules."
          },
          {
            "target": "./lib/logistics",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/ratings", "./lib/community"],
            "message": "lib/logistics must not depend on other domain modules."
          },
          {
            "target": "./lib/ratings",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/community"],
            "message": "lib/ratings must not depend on other domain modules."
          },
          {
            "target": "./lib/community",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/ratings"],
            "message": "lib/community must not depend on other domain modules."
          },
          {
            "target": "./lib/forecast",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/ratings", "./lib/community", "./lib/client-portal", "./lib/analytics"],
            "message": "lib/forecast must not depend on other domain modules."
          },
          {
            "target": "./lib/client-portal",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/ratings", "./lib/community", "./lib/forecast", "./lib/analytics"],
            "message": "lib/client-portal must not depend on other domain modules."
          },
          {
            "target": "./lib/analytics",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/ratings", "./lib/community", "./lib/forecast", "./lib/client-portal"],
            "message": "lib/analytics must not depend on other domain modules."
          },
          {
            "target": "./lib/openapi",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/ratings", "./lib/community", "./lib/forecast", "./lib/client-portal", "./lib/analytics", "./lib/erp", "./lib/scoring"],
            "message": "lib/openapi must not depend on other domain modules."
          },
          {
            "target": "./lib/erp",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/ratings", "./lib/community", "./lib/forecast", "./lib/client-portal", "./lib/analytics", "./lib/openapi", "./lib/scoring"],
            "message": "lib/erp must not depend on other domain modules."
          },
          {
            "target": "./lib/scoring",
            "from": ["./lib/orders", "./lib/settlement", "./lib/ai-quote", "./lib/catalog", "./lib/pricing", "./lib/projects", "./lib/pb", "./lib/groupbuy", "./lib/finance", "./lib/logistics", "./lib/ratings", "./lib/community", "./lib/forecast", "./lib/client-portal", "./lib/analytics", "./lib/openapi", "./lib/erp"],
            "message": "lib/scoring must not depend on other domain modules."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["node_modules", ".next", "supabase", "*.config.*"]
}
