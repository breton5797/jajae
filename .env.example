# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic (AI BOM / search assist). If unset, deterministic fallback is used.
ANTHROPIC_API_KEY=

# OpenAI Whisper STT. 미설정 시 수동 전사 입력 폴백.
# 제안서 'AI 실사 변환'(3D 스냅샷→포토리얼)에도 사용(이미지 권한 필요). 미설정 시 원본 3D 렌더 유지.
OPENAI_API_KEY=

# AI 실사 렌더 provider 오버라이드(선택). 미설정 시 OPENAI_API_KEY/openai 사용.
# 모델: gpt-image-1(기본)·gpt-image-1.5·gpt-image-1-mini / 품질: low·medium(기본)·high
STUDIO_RENDER_PROVIDER=
STUDIO_RENDER_API_KEY=
STUDIO_RENDER_MODEL=
STUDIO_RENDER_QUALITY=

# Toss Payments (test keys). If unset, sandbox/mock path is used.
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Popbill 전자세금계산서. BOTH required for real issuance; if either is unset,
# a deterministic mock invoice is returned (see lib/finance/popbill.ts).
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=

# Kakao OAuth (configured in Supabase Auth provider; client id optional for map)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Platform
PLATFORM_FEE_RATE=0.03

# ---------------------------------------------------------------------------
# DEV-ONLY admin sign-in helper (app/api/dev-login). Lets a seeded email/password
# admin establish a session locally because real login is Kakao OAuth. Hard-gated:
# the route 404s unless NODE_ENV !== 'production' AND DEV_LOGIN === 'true'.
# Set ONLY in .env.local — NEVER in production. Leave blank/omit in prod.
# ---------------------------------------------------------------------------
DEV_LOGIN=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
